#!/usr/bin/env python3
"""
Print the resource usage for each user under a slurm account, broken down by partition.
"""
import os
import sys
import grp
import json
import datetime
import subprocess as subp
from collections import defaultdict
from rich.console import Console
from rich.table import Table
from rich.tree import Tree

console = Console(width=200, color_system="truecolor")

MAX_USERNAME_LENGTH = 100

IGNORE_PARTITIONS = ["cpu-preempt", "gpu-preempt"]

squeue_json = None

def user_usage(accounts=None, partitions=None, states=None):
    """
    returns a report of the total number of CPU's and GPU's each user is using per partition
    slurm arguments for accounts, partitions, states, don't seem to work.
    accounts/partitions/states are case insensitive.
    """
    global squeue_json
    jobs = squeue_json["jobs"]

    usage_by_partition = defaultdict(lambda: defaultdict(lambda: {"cpu": 0, "gpu": 0}))
    total_usage = {"cpu": 0, "gpu": 0}

    for job in jobs:
        partition = job["partition"]
        account = job["account"]
        job_states = job["job_state"]
        if account not in accounts:
            continue
        if partition not in partitions:
            continue
        if not set(states).intersection(set(job_states)):
            continue
        user = job["user_name"]
        num_cpus = job["cpus"]["number"]
        num_gpus = 0
        tres_str = job["tres_alloc_str"]
        if len(tres_str) == 0:
            tres_str = job["tres_req_str"]
        for resource in tres_str.split(','):
            if resource.startswith("gres/gpu="):
                num_gpus += int(resource.rsplit('=',1)[-1])

        usage_by_partition[partition][user]["cpu"] += num_cpus
        usage_by_partition[partition][user]["gpu"] += num_gpus
        total_usage["cpu"] += num_cpus
        total_usage["gpu"] += num_gpus

    return usage_by_partition, total_usage

my_username = os.environ["USER"]
my_gid = os.getgid()
groups = [g.gr_name for g in grp.getgrall() if my_username in g.gr_mem or g.gr_gid == my_gid]
pi_groups = [x for x in groups if x.startswith("pi_")]

if squeue_json is None:
    print("collecting info from slurm...", end="\r", file=sys.stderr)
    squeue_json = json.loads(subp.check_output(["squeue", "--all", "--json"], timeout=10, errors="ignore"))

if "-a" in  sys.argv:
    IGNORE_PARTITIONS = []

now = datetime.datetime.now()
tree = Tree(f"Accounts (@{now})")

for pi_group in pi_groups:
    total_account_usage = {"cpu": 0, "gpu": 0}

    skip_totals = True
    pitree = None
    for partition in sorted(set(job["partition"] for job in squeue_json["jobs"]) - set(IGNORE_PARTITIONS)):
        running_usage, _ = user_usage(accounts=[pi_group], partitions=[partition], states=["RUNNING"])
        pending_usage, _ = user_usage(accounts=[pi_group], partitions=[partition], states=["PENDING"])

        users = set()
        users.update(running_usage[partition].keys())
        users.update(pending_usage[partition].keys())

        if not users:
            continue
        skip_totals = False
        # Only add if we are going to have some data
        if not pitree:
            pitree = tree.add(f"[underline]Account {pi_group}")

        table = Table(title=f"Partition: {partition}")
        table.add_column("username", width=60)
        table.add_column("CPUs allocated", justify="right", width=10)
        table.add_column("GPUs allocated", justify="right", width=10)
        table.add_column("CPUs pending", justify="right", width=10)
        table.add_column("GPUs pending", justify="right", width=10)
        for user in sorted(users):
            cpu_alloc = running_usage[partition][user]["cpu"]
            gpu_alloc = running_usage[partition][user]["gpu"]
            cpu_pending = pending_usage[partition][user]["cpu"]
            gpu_pending = pending_usage[partition][user]["gpu"]
            table.add_row(*[str(td) for td in [user, cpu_alloc, gpu_alloc, cpu_pending, gpu_pending]])

        pitree.add(table)

        partition_total = {
            "cpu_alloc": sum(running_usage[partition][user]["cpu"] for user in users),
            "gpu_alloc": sum(running_usage[partition][user]["gpu"] for user in users),
            "cpu_pending": sum(pending_usage[partition][user]["cpu"] for user in users),
            "gpu_pending": sum(pending_usage[partition][user]["gpu"] for user in users),
        }
        total_account_usage["cpu"] += partition_total["cpu_alloc"]
        total_account_usage["gpu"] += partition_total["gpu_alloc"]

        if not skip_totals:
            table.add_row(*[str(td) for td in ["Total", *partition_total.values()]])
        else:
            table.add_row(*[str(td) for td in ["Total", None, None, None, None]])
    if not pitree:
        tree.add(f"[underline]Account {pi_group} - No Usage")

console.print(tree)
